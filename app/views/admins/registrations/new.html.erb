<div class="card">
  <h1>Admin Sign Up</h1>
  <p class="muted">Sign up is invite-only.</p>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "shared/errors", resource: resource %>

    <div class="field">
      <%= f.label :name, "Full name" %>
      <%= f.text_field :name, autofocus: true, autocomplete: "name", required: true %>
    </div>

    <div class="field">
      <%= f.label :email %>
      <%= f.email_field :email, autocomplete: "email", required: true %>
    </div>

    <div class="field">
      <%= f.label :password %>
      <%= f.password_field :password, autocomplete: "new-password", required: true %>
      <% if @minimum_password_length %>
        <small class="muted">At least <%= @minimum_password_length %> characters</small>
      <% end %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "Confirm password" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %>
    </div>

    <div class="field">
      <%= f.label :invite_code, "Invite code" %>
      <%= f.password_field :invite_code, autocomplete: "off", required: true %>
    </div>

    <%= f.submit "Sign up", class: "btn" %>
  <% end %>

  <div class="links">
    Already have an account? <%= link_to "Log in", new_admin_session_path %>
  </div>
</div>
