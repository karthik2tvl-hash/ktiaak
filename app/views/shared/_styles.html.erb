<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    min-height: 100vh; display: grid; place-items: center; padding: 1rem;
    background: linear-gradient(135deg, #0b1020, #1a1033 60%, #24135a);
    color: #e8ecf8;
  }
  .card {
    width: min(420px, 100%); padding: 2rem; border-radius: 18px;
    background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12);
    backdrop-filter: blur(10px); box-shadow: 0 20px 60px rgba(0,0,0,.4);
  }
  h1 { font-size: 1.7rem; margin-bottom: .3rem; }
  .muted { color: #9aa6c7; margin-bottom: 1.2rem; }
  small.muted { display: block; margin: .3rem 0 0; font-size: .8rem; }
  .field { margin-bottom: 1rem; }
  label { display: block; font-size: .85rem; margin-bottom: .3rem; color: #c9d1ee; }
  input[type=text], input[type=email], input[type=password] {
    width: 100%; padding: .75rem .9rem; border-radius: 10px; font-size: 1rem;
    border: 1px solid rgba(255,255,255,.2); background: rgba(0,0,0,.25); color: #fff;
  }
  input:focus { outline: 2px solid #6c7bff; border-color: transparent; }
  .check { display: flex; align-items: center; gap: .5rem; margin-bottom: 1rem; font-size: .9rem; }
  .btn {
    width: 100%; padding: .85rem; border: 0; border-radius: 999px; cursor: pointer;
    font-weight: 700; font-size: 1rem; color: #fff;
    background: linear-gradient(90deg, #6c7bff, #8b5cf6); transition: transform .2s, box-shadow .2s;
  }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(108,123,255,.45); }
  .btn.secondary { background: transparent; border: 1px solid rgba(255,255,255,.3); margin-top: 1rem; }
  .links { margin-top: 1.2rem; text-align: center; font-size: .9rem; line-height: 1.9; }
  .links a { color: #22d3ee; text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  .flash { width: min(420px, 100%); padding: .7rem 1rem; border-radius: 10px; margin-bottom: 1rem; font-size: .9rem; }
  .flash.notice { background: rgba(34,197,94,.18); color: #86efac; }
  .flash.alert  { background: rgba(239,68,68,.18); color: #fca5a5; }
  .errors { background: rgba(239,68,68,.15); color: #fca5a5; padding: .7rem 1rem; border-radius: 10px; margin-bottom: 1rem; font-size: .9rem; }
  .errors ul { padding-left: 1.1rem; }
  .dashboard p { margin-bottom: .6rem; }
</style>
