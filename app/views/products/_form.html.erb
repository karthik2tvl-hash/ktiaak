<%= form_with model: product do |f| %>
  <%= render "shared/errors", record: product %>

  <div class="form-grid two">
    <div>
      <%= f.label :name, "Product name" %>
      <%= f.text_field :name, required: true, autofocus: true %>
    </div>
    <div>
      <%= f.label :sku, "SKU" %>
      <%= f.text_field :sku, required: true %>
      <div class="hint">Unique code, saved in capitals.</div>
    </div>
    <div>
      <%= f.label :price, "Price (₹)" %>
      <%= f.number_field :price, step: "0.01", min: 0, required: true %>
    </div>
    <div>
      <%= f.label :stock, "Stock quantity" %>
      <%= f.number_field :stock, step: 1, min: 0 %>
    </div>
    <div class="span-2">
      <%= f.label :category %>
      <%= f.text_field :category %>
    </div>
    <div class="span-2">
      <%= f.label :description %>
      <%= f.text_area :description, rows: 4 %>
    </div>
    <div class="check span-2">
      <%= f.check_box :active %>
      <%= f.label :active, "Active (visible on the site)" %>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn" %>
    <%= link_to "Cancel", products_path, class: "btn secondary" %>
  </div>
<% end %>
